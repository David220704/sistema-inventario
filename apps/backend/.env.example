# ─── Producción (Neon) ───────────────────────────────────────────
# 1. Crea cuenta gratis en https://neon.tech
# 2. Crea un proyecto → copia la connection string
# 3. Pégala aquí:
# DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/inventario?sslmode=require"
#
# ─── Local ───────────────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventario"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventario"
JWT_SECRET="change-this-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:3000"
